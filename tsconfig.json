{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["bun"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts/**/*.ts",
    "packages/yolo-bun-plugin/src/**/*.ts",
    "packages/windows/src/**/*.ts",
    "packages/windows/test/**/*.ts"
  ],
  "exclude": ["node_modules", "upstream", "vendor", "dist", "target"]
}
