{
  "name": "yolo",
  "version": "1.4.4-canary.1",
  "description": "YOLO Unified Sovereign Runtime, Bun Version Manager (stable/canary/custom-aot), Chromium/Google Open Source Toolkit & Fleet Meta-Platform",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4-canary.1",
  "license": "MIT OR Apache-2.0",
  "bin": {
    "yolo": "./scripts/yolo.ts",
    "bun": "./scripts/yolo.ts",
    ".bun": "./scripts/yolo.ts"
  },
  "catalog": {
    "@types/bun": "^1.4.4"
  },
  "workspaces": [
    "packages/bun-loaders",
    "packages/package-converter",
    "packages/bun-workspace",
    "packages/yolo-bun-plugin"
  ],
  "scripts": {
    "yolo": "bun scripts/yolo.ts",
    "bvm": "bun scripts/yolo.ts bvm",
    "bvm:status": "bun scripts/yolo.ts bvm status",
    "bvm:use:stable": "bun scripts/yolo.ts bvm use stable",
    "bvm:use:canary": "bun scripts/yolo.ts bvm use canary",
    "bvm:use:aot": "bun scripts/yolo.ts bvm use custom-aot",
    "test": "bun test ./scripts/bun-com-fork.test.ts ./scripts/google-bun-fusion.test.ts ./scripts/image-plan.test.ts ./scripts/package-install.test.ts ./scripts/source-guards.test.ts ./scripts/verify-image-plan-readonly.test.ts ./scripts/verify-image-plan.test.ts ./scripts/upstream-watch/watch.test.ts ./scripts/bvm.test.ts",
    "check": "bun check --no-script ./scripts/yolo.ts ./scripts/bvm.ts ./packages/yolo-bun-plugin/src ./packages/bun-loaders/src ./packages/package-converter/src ./packages/bun-workspace/src/runtime.ts ./packages/bun-workspace/src/hash.ts ./packages/bun-workspace/src/process.ts ./packages/bun-workspace/src/capabilities.ts ./packages/bun-workspace/src/guards.ts",
    "check:aot": "bun run scripts/check-aot.ts",
    "lint": "bun lint --no-script ./scripts/yolo.ts ./scripts/bvm.ts ./scripts/bun-com-fork.ts ./scripts/web-standards-vitals.ts ./packages/yolo-bun-plugin/src ./packages/bun-loaders/src",
    "fmt": "bun fmt --no-script scripts/yolo.ts scripts/bvm.ts scripts/bvm.test.ts packages/yolo-bun-plugin packages/bun-loaders package.json",
    "fmt:check": "bun fmt --no-script --check scripts/yolo.ts scripts/bvm.ts scripts/bvm.test.ts packages/yolo-bun-plugin packages/bun-loaders package.json",
    "bun:com:index": "bun run scripts/yolo.ts site index",
    "bun:com:search": "bun run scripts/yolo.ts site search",
    "bun:com:audit": "bun run scripts/yolo.ts site audit",
    "bun:com:serve": "bun run scripts/yolo.ts site serve",
    "upstream:watch": "bun run scripts/upstream-watch/cli.ts",
    "status": "bun run scripts/status.ts",
    "status:json": "bun run scripts/status.ts --json",
    "status:watch": "bun run scripts/status.ts --watch",
    "pm": "bun run scripts/pm.ts",
    "registry:check": "bun run scripts/registry-check.ts",
    "publish:all": "bun run scripts/publish-all.ts",
    "fleet:hosts": "bun run fleet/fleet.ts hosts",
    "fleet:audit": "bun run fleet/fleet.ts audit",
    "fleet:ssh-config": "bun run fleet/fleet.ts ssh-config",
    "fleet:sync": "bun run scripts/fleet-sync.ts",
    "storage:status": "bun run scripts/storage-status.ts",
    "doctor": "bun run ../yolo-plugins/src/cli.ts doctor",
    "test:all": "bun run scripts/test-all.ts",
    "sync:all": "bun run ../yolo-plugins/src/cli.ts sync",
    "grind": "bun scripts/grind.ts",
    "goal": "bun scripts/grind.ts",
    "sync:watch": "bun scripts/auto-sync.ts",
    "recursive:loop": "bun scripts/recursive-evolution.ts",
    "consolidate:audit": "bun scripts/consolidate.ts audit",
    "consolidate:plan": "bun scripts/consolidate.ts apply",
    "consolidate:apply": "bun scripts/consolidate.ts apply --execute",
    "upstream": "bun scripts/upstream-monitor.ts",
    "git:status": "bun scripts/yolo-git.ts status",
    "git:sync": "bun scripts/yolo-git.ts sync",
    "git:orgs": "bun scripts/yolo-git.ts orgs",
    "build:yolo": "bun build --compile --outfile bin/yolo.exe scripts/yolo.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
