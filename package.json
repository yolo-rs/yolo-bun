{
  "name": "@yolo-rs/yolo-bun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4-canary.1",
  "bin": {
    "yolo": "scripts/yolo.ts"
  },
  "license": "MIT OR Apache-2.0",
  "workspaces": [
    "packages/yolo-bun-plugin",
    "packages/windows"
  ],
  "description": "Patched integration monorepo around the upstream Bun Rust runtime",
  "scripts": {
    "test": "bun test ./scripts",
    "check": "bun check --no-script ./scripts ./packages/yolo-bun-plugin/src ./packages/windows/src",
    "check:aot": "bun run scripts/check-aot.ts",
    "lint": "bun lint --no-script ./scripts ./packages/yolo-bun-plugin/src ./packages/windows/src",
    "fmt": "bun fmt --no-script scripts packages/yolo-bun-plugin packages/windows README.md docs/receipts package.json",
    "fmt:check": "bun fmt --no-script --check scripts packages/yolo-bun-plugin packages/windows README.md docs/receipts package.json",
    "yolo": "bun scripts/yolo.ts",
    "upstream:watch": "bun run scripts/upstream-watch/cli.ts",
    "test:upstream-watch": "bun test ./scripts/upstream-watch",
    "bench:runtime": "bun run scripts/bench-runtime.ts",
    "source:prepare": "bun run scripts/prepare-bun-source.ts",
    "packages:backends": "bun run scripts/package-backends.ts",
    "packages:image-plan": "bun run scripts/image-plan.ts",
    "packages:verify-image-plan": "bun run scripts/verify-image-plan.ts",
    "packages:install": "bun run scripts/package-install.ts",
    "packages:resolve": "bun run scripts/package-resolve.ts",
    "packages:cli:check:aot": "bun check --no-script --aot scripts/yolo.ts",
    "packages:cli:build:bytecode": "bun build --compile --bytecode --outfile dist/bin/yolo scripts/yolo.ts",
    "packages:cli:build:aot": "bun build --compile --aot --outfile dist/bin/yolo scripts/yolo.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4"
  }
}
